# Firebase Server Authentication
# Path to your downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/guesswhosesong-firebase-adminsdk.json

# Spotify Developer Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8080/spotify/callback

# Redis Backend
REDIS_URL=redis://localhost:6379

# Server Port
PORT=8080
